QWidget { color: #172033; font-family: "Segoe UI"; font-size: 13px; }
QMainWindow, QStackedWidget { background: #F4F7FB; }
QLabel#PageTitle { font-size: 25px; font-weight: 700; color: #111827; }
QLabel#MutedLabel { color: #68758A; }
QLabel#Brand { color: #FFFFFF; font-size: 20px; font-weight: 800; letter-spacing: 1px; }
QLabel#AuthTitle { font-size: 26px; font-weight: 700; }
QLabel#MetricValue { font-size: 22px; font-weight: 700; color: #0F172A; }
QFrame#Sidebar { background: #111D35; border: none; }
QFrame#AuthCard, QFrame#BalanceCard { background: #FFFFFF; border: 1px solid #E4EAF2; border-radius: 14px; }
QFrame#BalanceCard { padding: 10px; }
QPushButton { border: none; border-radius: 8px; padding: 9px 14px; font-weight: 600; }
QPushButton#PrimaryButton { background: #2563EB; color: white; }
QPushButton#PrimaryButton:hover { background: #1D4ED8; }
QPushButton#SecondaryButton { background: #E7EDF6; color: #24334D; }
QPushButton#DangerButton { background: #DC4545; color: white; }
QPushButton#TextButton { color: #2563EB; background: transparent; }
QPushButton#NavButton { text-align: left; color: #D8E2F2; background: transparent; padding: 11px 12px; }
QPushButton#NavButton:hover { background: #263956; color: white; }
QLineEdit, QComboBox, QDoubleSpinBox { background: #FFFFFF; border: 1px solid #D8E0EC; border-radius: 8px; padding: 8px 10px; selection-background-color: #2563EB; }
QLineEdit:focus, QComboBox:focus, QDoubleSpinBox:focus { border: 1px solid #2563EB; }
QTableWidget { background: white; alternate-background-color: #F8FAFD; border: 1px solid #E1E7F0; border-radius: 8px; gridline-color: #E8EDF4; }
QHeaderView::section { background: #EAF0F8; border: none; padding: 10px; font-weight: 700; }
QMessageBox { background: white; }
