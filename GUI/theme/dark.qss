/* Aurelia — deep forest night */
QWidget { color: #E5F0E9; font-family: "Segoe UI"; font-size: 13px; }
QMainWindow, QStackedWidget { background: #0C1913; }
QLabel#PageTitle, QLabel#HeaderTitle { font-size: 25px; font-weight: 800; color: #F0F8F3; }
QLabel#MutedLabel { color: #9BB2A4; }
QLabel#SectionLabel { color: #D1E6D8; font-size: 14px; font-weight: 750; }
QLabel#UserBadge { background: #173B2B; color: #A9E8C2; border: 1px solid #28583F; border-radius: 18px; padding: 9px 14px; font-size: 11px; font-weight: 800; }
QLabel#DetailValue { color: #E4F2E9; background: #14271D; border: 1px solid #294334; border-radius: 9px; padding: 10px 12px; }
QLabel#InsightBanner { background: #163A2A; color: #B6EBCB; border: 1px solid #28563D; border-radius: 13px; padding: 16px 18px; font-size: 14px; font-weight: 750; }
QFrame#AppHeader { background: #122219; border: 1px solid #263E30; border-radius: 17px; }
QFrame#Sidebar { background: #07120D; border: none; }
QLabel#BrandMark { background: #19A66A; color: white; border-radius: 11px; min-width: 36px; max-width: 36px; min-height: 36px; max-height: 36px; qproperty-alignment: AlignCenter; font-size: 19px; font-weight: 900; }
QLabel#Brand { color: #FFFFFF; font-size: 17px; font-weight: 900; letter-spacing: 2px; }
QLabel#BrandCaption, QLabel#NavSection, QLabel#SidebarFooter { color: #789D87; font-size: 9px; font-weight: 850; letter-spacing: 1.5px; }
QFrame#AuthCard, QFrame#BalanceCard { background: #14251B; border: 1px solid #2A4233; border-radius: 17px; }
QLabel#MetricValue { font-size: 24px; font-weight: 850; color: #F0F8F3; }
QPushButton { border: none; border-radius: 10px; padding: 10px 15px; font-weight: 750; }
QPushButton#PrimaryButton { background: #20A66A; color: white; }
QPushButton#PrimaryButton:hover { background: #35BD7E; }
QPushButton#SecondaryButton { background: #203B2C; color: #DDF2E5; border: 1px solid #31533E; }
QPushButton#SecondaryButton:hover { background: #294A36; }
QPushButton#DangerButton { background: #48292B; color: #FFC1BE; }
QPushButton#TextButton { color: #83D9A8; background: transparent; }
QPushButton#NavButton { text-align: left; color: #C5D9CC; background: transparent; padding: 10px 12px; border-radius: 10px; font-size: 12px; }
QPushButton#NavButton:hover { background: #183A29; color: white; }
QPushButton#NavButton:checked { background: #20563A; color: white; border-left: 3px solid #5BE0A0; padding-left: 9px; }
QPushButton#LogoutButton { text-align: left; background: #183326; color: #F2B5B2; }
QLineEdit, QComboBox, QDoubleSpinBox, QSpinBox { background: #102018; color: #E7F2EA; border: 1px solid #34503E; border-radius: 10px; padding: 9px 11px; }
QLineEdit:focus, QComboBox:focus, QDoubleSpinBox:focus, QSpinBox:focus { border: 1px solid #45C486; }
QTableWidget { background: #14251B; alternate-background-color: #192D21; border: 1px solid #2A4233; border-radius: 13px; gridline-color: #2B4133; selection-background-color: #24563B; outline: none; }
QTableWidget::item { padding: 8px; border-bottom: 1px solid #233B2C; }
QHeaderView::section { background: #20372A; color: #C6DCCF; border: none; padding: 12px 9px; font-size: 10px; font-weight: 900; }
QScrollBar:vertical { background: transparent; width: 8px; }
QScrollBar::handle:vertical { background: #45634F; border-radius: 4px; min-height: 24px; }
QMessageBox { background: #14251B; }
QToolTip { background: #E7F2EA; color: #102A1D; border: none; padding: 7px 9px; }
QFrame#HeroPanel { background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #10442F, stop:1 #187B4D); border: 1px solid #2B7951; border-radius: 20px; }
QLabel#HeroEyebrow { color: #B9F0D0; font-size: 9px; font-weight: 900; letter-spacing: 2px; }
QLabel#HeroTitle { color: white; font-size: 25px; font-weight: 850; }
QLabel#HeroSubtitle { color: #D7F5E4; font-size: 12px; }
QFrame#AuthHero { background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #0B281C, stop:0.58 #104D33, stop:1 #187B4D); border-radius: 24px; }
QLabel#AuthBrand { color: white; font-size: 18px; font-weight: 950; letter-spacing: 3px; }
QLabel#AuthEyebrow { color: #B9F0D0; font-size: 9px; font-weight: 900; letter-spacing: 2px; }
QLabel#AuthHeroTitle { color: white; font-size: 39px; font-weight: 900; }
QLabel#AuthHeroText { color: #D7F5E4; font-size: 13px; }
QLabel#AuthTitle { font-size: 29px; font-weight: 850; color: #F0F8F3; }
QFrame#AuthCard { min-width: 370px; }
